# Copy to .env.local. Never put secret values in NEXT_PUBLIC_* variables.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (or legacy service_role key); server only
SUPABASE_SECRET_KEY=
# Same Google OAuth client configured in Supabase; used to refresh Calendar access
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=
# off | dry-run | live. Default off. dry-run never contacts providers.
NOTIFICATION_MODE=off
RESEND_API_KEY=
EMAIL_FROM=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=
KAKAO_PF_ID=
KAKAO_TEMPLATE_CONFIRMED=
KAKAO_TEMPLATE_CANCELLED=
# Random secret for protected queue processor, at least 32 characters
CRON_SECRET=
